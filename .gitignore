# Build output
bin/
obj/
*.user
*.suo

# Secrets and local state
.env

# Raw source data — downloaded by `just fetch`, never committed (see data/manifest.json)
/data/raw/

# Local workspace storage (the Docker volume)
/.workspace/

# Scratch output of `just export-definitions` — diff it, copy what you want, never commit it
/.export/

# Embedding benchmark: Python env, model downloads, vectors and reports
/tools/embedding-benchmark/.venv/
/tools/embedding-benchmark/out/
/tools/cluster-benchmark/.venv/

# Embeddings server: Python env, log and PID
/tools/embedding-server/.venv/
/tools/embedding-server/server.log*
/tools/embedding-server/server.pid

# Tooling
.idea/
.vs/
.vscode/
.claude/settings.local.json
# Copied in by the Tesserae package on every front-end build (its own skill): build output
/.claude/skills/tesserae/
*.DotSettings.user

# OS
.DS_Store
Thumbs.db
