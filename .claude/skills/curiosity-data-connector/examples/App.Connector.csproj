<!--
  Reference template — see ../SKILL.md and curiosity-toolchain-and-packages.

  Versions below were current at the time of writing. UPDATE TO THE LATEST RELEASE FIRST,
  in its own commit, then pin what you resolve. Never use a floating range.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>App.Connector</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The graph client: Graph.Connect, [Node]/[Key]/[Property]/[Timestamp],
         HashCache, CommitPendingAsync, UploadFileAsync. -->
    <PackageReference Include="Curiosity.Library"                    Version="26.10.6427" />
    <PackageReference Include="Microsoft.Extensions.Logging"         Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />

    <!-- Source readers — reference ONLY the formats this connector actually reads.
         System.Text.Json, System.Xml.Linq, System.IO.Compression and System.Net.Http
         are in-box and need no reference. -->
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <!-- <PackageReference Include="Parquet.Net"                Version="…" /> -->
    <!-- <PackageReference Include="ClosedXML"                  Version="…" /> -->
    <!-- <PackageReference Include="ExcelDataReader"            Version="…" /> -->
    <!-- <PackageReference Include="YamlDotNet"                 Version="…" /> -->
    <!-- <PackageReference Include="Dapper"                     Version="…" /> -->
    <!-- <PackageReference Include="Npgsql"                     Version="…" /> -->
    <!-- <PackageReference Include="Microsoft.Data.SqlClient"   Version="…" /> -->
  </ItemGroup>

  <ItemGroup>
    <!-- The corpus read model is the executable schema: the validator and the connector
         both deserialise through it, so the corpus cannot drift without failing a build. -->
    <ProjectReference Include="..\App.Dataset\App.Dataset.csproj" />
  </ItemGroup>

</Project>
