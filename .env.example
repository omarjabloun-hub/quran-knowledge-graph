# Copy to .env (`just setup` does) and adjust. .env is gitignored: never commit it.
# Every script reads it from the repository root.

# ── The local workspace (docker-compose.yml) ─────────────────────────────────────────────
# Image tag of curiosityai/curiosity. 72111 is the build this repository was verified against;
# `latest` follows the newest release.
CURIOSITY_VERSION=72111
WORKSPACE_INSTANCE=local
WORKSPACE_PORT=8080
# The administrator a FRESH workspace is created with (changing these later has no effect on an
# existing .workspace/ folder). `just tokens` signs in with them to mint the two tokens below.
WORKSPACE_ADMIN_USER=admin
WORKSPACE_ADMIN_PASSWORD=admin
WORKSPACE_ADMIN_EMAIL=admin@localhost.local

# ── The workspace the scripts talk to ─────────────────────────────────────────────────────
CURIOSITY_URL=http://localhost:8080/
# `just tokens` writes these two. By hand: Manage > Tokens > Library / Interface Upload.
CURIOSITY_API_TOKEN=replace-with-api-token
INTERFACE_UPLOAD_TOKEN=replace-with-interface-upload-token
WORKSPACE_CONNECTOR_NAME="Quran Knowledge Graph"

# ── A second workspace (optional) — used with `--target prod` ────────────────────────────
# Nothing falls back to the local values: a missing PROD_ value is an error.
PROD_CURIOSITY_URL=
PROD_CURIOSITY_API_TOKEN=
PROD_INTERFACE_UPLOAD_TOKEN=
PROD_WORKSPACE_ADMIN_USER=
PROD_WORKSPACE_ADMIN_PASSWORD=

# ── Models (see docs/models.md) ───────────────────────────────────────────────────────────
# Which model embeds the Arabic of every verse (the Verse.TextSimple index):
#   harrier  the workspace's built-in model — no setup, runs on the CPU inside the container
#   ollama   OLLAMA_EMBEDDING_MODEL served by Ollama on the Mac's GPU — `just embeddings-ollama`
EMBEDDING_PROVIDER=harrier
# Ollama as the WORKSPACE CONTAINER sees it (the Mac itself is host.docker.internal from inside).
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:8b
# The chat model for the workspace's assistant and for naming clusters (Manage > AI > Providers).
OLLAMA_CHAT_MODEL=qwen3:32b
